  "skill": {
    "id":       "sk_url_extract",
    "name":     "url_extract",
    "language": "javascript",
    "source":   "// url_extract: fetches a URL and extracts plain-text content.\n// params: { url: string }\n// returns: { url, title, text, status }\nasync function run(params) {\n  const res = await fetch(params.url, { redirect: 'follow' })\n  const html = await res.text()\n  const title = (html.match(/<title[^>]*>([^<]*)<\\/title>/i) || [, ''])[1].trim()\n  const text = html\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n  return { url: params.url, title, text: text.slice(0, 12000), status: res.status }\n}\nreturn run(params)",
    "inputSchema": {
      "type": "object",
      "properties": { "url": { "type": "string" } },
      "required": ["url"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "url":    { "type": "string" },
        "title":  { "type": "string" },
        "text":   { "type": "string" },
        "status": { "type": "number" }
      },
      "required": ["url", "text"]
    }
  },

  "agent1": {
